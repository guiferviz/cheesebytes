---
const { class: className } = Astro.props;
---

<svg
  width="96"
  height="96"
  viewBox="0 0 96 96"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <rect
    x="4"
    y="4"
    width="88"
    height="88"
    rx="18"
    class="fill-green-900/30 dark:fill-green-900/50"></rect>

  <path
    d="M28 50 L42 64 L68 32"
    class="stroke-green-600 dark:stroke-green-300"
    stroke-width="10"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
