---
const { class: className } = Astro.props;
---

<svg
  width="96"
  height="96"
  viewBox="0 0 96 96"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <rect
    x="4"
    y="4"
    width="88"
    height="88"
    rx="18"
    class="fill-red-900/30 dark:fill-red-900/50"></rect>

  <path
    d="M32 32 L64 64"
    class="stroke-red-600 dark:stroke-red-300"
    stroke-width="10"
    stroke-linecap="round"></path>
  <path
    d="M64 32 L32 64"
    class="stroke-red-600 dark:stroke-red-300"
    stroke-width="10"
    stroke-linecap="round"></path>
</svg>
