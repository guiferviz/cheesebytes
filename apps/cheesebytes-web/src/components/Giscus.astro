<div id="giscus-container"></div>

<script>
  function getInitialIsDark() {
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme === "dark") return true;
    if (savedTheme === "light") return false;

    if (document.documentElement.classList.contains("dark")) return true;
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function updateGiscusTheme(isDark: boolean) {
    const theme = isDark ? "dark" : "light";
    const iframe: any = document.querySelector("iframe.giscus-frame");

    if (iframe?.contentWindow) {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme } } },
        "https://giscus.app",
      );
    }

    const giscusScript = document.getElementById("giscus-script");
    if (giscusScript) {
      giscusScript.setAttribute("data-theme", theme);
    }
  }

  (function initGiscus() {
    const isDark = getInitialIsDark();
    const theme = isDark ? "dark" : "light";
    const container = document.getElementById("giscus-container");
    if (!container) return;

    // Render script dynamically with the correct initial theme
    const script = document.createElement("script");
    script.id = "giscus-script";
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", "guiferviz/cheesebytes");
    script.setAttribute("data-repo-id", "R_kgDOOMjuVA");
    script.setAttribute("data-category", "Comments");
    script.setAttribute("data-category-id", "DIC_kwDOOMjuVM4CpDXM");
    script.setAttribute("data-mapping", "pathname");
    script.setAttribute("data-strict", "1");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "bottom");
    script.setAttribute("data-theme", theme);
    script.setAttribute("data-lang", "en");
    script.setAttribute("crossorigin", "anonymous");
    script.async = true;
    container.appendChild(script);

    // Safety: ensure iframe receives the chosen theme once it appears
    const observer = new MutationObserver((_, obs) => {
      const iframe = document.querySelector("iframe.giscus-frame");
      if (iframe) {
        updateGiscusTheme(isDark);
        obs.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  })();

  document.addEventListener("themeChanged", (event: Event) => {
    const detail = (event as CustomEvent<{ isDark?: boolean }>).detail;
    const isDark =
      detail?.isDark ?? document.documentElement.classList.contains("dark");
    updateGiscusTheme(isDark);
  });

  window.addEventListener("storage", (event) => {
    if (event.key === "theme") {
      const isDark = event.newValue === "dark";
      updateGiscusTheme(isDark);
    }
  });
</script>
