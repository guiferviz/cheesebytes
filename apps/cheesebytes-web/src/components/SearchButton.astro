---
// SearchButton.astro
---

<button
  id="search-button"
  class="w-full flex items-center gap-3 px-3 py-2 text-sm text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg transition-colors border border-gray-200 dark:border-gray-700"
  onclick="window.handleSearchClick && window.handleSearchClick(event)"
>
  <svg
    class="w-4 h-4 flex-shrink-0"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
  <span class="flex-1 text-left">Search notes...</span>
  <kbd
    class="px-2 py-1 text-xs font-semibold text-gray-400 dark:text-gray-500 bg-gray-200 dark:bg-gray-600 rounded"
    >⌘K</kbd
  >
</button>

<script>
  // Definir función global para manejar el click del botón de búsqueda
  (window as any).handleSearchClick = function (e: Event) {
    e.preventDefault();
    e.stopPropagation();

    // Intentar usar la función global de apertura del modal
    if (typeof (window as any).openSearchModal === "function") {
      (window as any).openSearchModal();
      return;
    }

    // Fallback: buscar el modal directamente
    const modalElement = document.getElementById("search-modal");
    const searchInputElement = document.getElementById("search-input");

    if (modalElement && searchInputElement) {
      modalElement.classList.remove("hidden");
      searchInputElement.focus();

      // Cargar índice si existe la función
      if (typeof (window as any).loadSearchIndex === "function") {
        (window as any).loadSearchIndex();
      }
    } else {
      // Intentar de nuevo después de un pequeño delay
      setTimeout(() => {
        const retryModal = document.getElementById("search-modal");
        const retryInput = document.getElementById("search-input");

        if (retryModal && retryInput) {
          retryModal.classList.remove("hidden");
          retryInput.focus();

          if (typeof (window as any).loadSearchIndex === "function") {
            (window as any).loadSearchIndex();
          }
        }
      }, 100);
    }
  };
</script>
