---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import BaseHead from "../components/BaseHead.astro";
import SideBar from "../components/SideBar.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body
    class="bg-yellow-50 dark:bg-black text-gray-700 dark:text-gray-100 overflow-hidden"
  >
    <div class="flex h-screen overflow-hidden">
      <SideBar />

      <div
        id="content-scroll"
        class="flex-1 overflow-y-auto w-full flex justify-center"
      >
        <div class="w-full max-w-full flex-1">
          <slot />
        </div>
      </div>
    </div>

    <!-- Modal de búsqueda -->
    <SearchModal />

    <!-- VimMode -->
    <script>
      import { createVimMode } from "../utils/vim-mode";

      if (!(window as any).__vimMode) {
        const vm = createVimMode();
        (window as any).__vimMode = vm;
        (window as any).vimMode = vm;

        // Default commands
        vm.register("t", {
          label: "Toggle theme",
          category: "General",
          run: () => (window as any).toggleTheme?.(),
        });

        vm.register("s", {
          label: "Toggle sidebar",
          category: "General",
          run: () => (window as any).toggleSidebar?.(),
        });

        vm.register("f", {
          label: "Open search",
          category: "General",
          run: () => (window as any).openSearchModal?.(),
        });
      }
    </script>
  </body>
</html>
