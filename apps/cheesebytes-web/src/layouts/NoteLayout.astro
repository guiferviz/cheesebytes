---
import "../styles/note-content.css";
import Giscus from "../components/Giscus.astro";
import { format } from "date-fns";
import BaseLayout from "./BaseLayout.astro";
import CheeseRain from "../components/CheeseRain.tsx";

const { note, noteLinkIcons = [] } = Astro.props;
const cheeseImage =
  typeof note.cheeseImage === "string" && note.cheeseImage.length > 0
    ? note.cheeseImage
    : null;
const noteType =
  typeof note.noteType === "string" && note.noteType.length > 0
    ? note.noteType
    : null;

// Función para obtener la descripción del tooltip basada en el noteType
function getCheeseTooltip(noteType: string): {
  title: string;
  description: string;
} {
  switch (noteType) {
    case "white-full":
      return {
        title: "White Cheese (Burgos) - Stable",
        description:
          "Simple but stable note, unlikely to change significantly.",
      };
    case "white-wedge":
      return {
        title: "White Cheese (Burgos) - Developing",
        description: "Very new or simple note, likely to evolve and change.",
      };
    case "emmental-full":
      return {
        title: "Cheese with Holes (Emmental) - Stable",
        description:
          "Useful note with good structure, stable and unlikely to change.",
      };
    case "emmental-wedge":
      return {
        title: "Cheese with Holes (Emmental) - Developing",
        description:
          "Useful note with basic structure, but still has holes to fill.",
      };
    case "parmigiano-full":
      return {
        title: "Aged Cheese (Parmesan) - Stable",
        description: "Well-worked note, deep and structured, stable content.",
      };
    case "parmigiano-wedge":
      return {
        title: "Aged Cheese (Parmesan) - Developing",
        description: "Well-worked note with detailed content, still evolving.",
      };
    case "cabrales-full":
      return {
        title: "Blue Cheese (Cabrales) - Stable",
        description:
          "Advanced note, complex and very connected, stable content.",
      };
    case "cabrales-wedge":
      return {
        title: "Blue Cheese (Cabrales) - Developing",
        description: "Advanced note with complex ideas, still being refined.",
      };
    default:
      return {
        title: "Cheese Note",
        description: "A note in the Cheese Bytes system.",
      };
  }
}

const tooltipInfo = noteType ? getCheeseTooltip(noteType) : null;
---

<BaseLayout title={note.title} description={note.description}>
  <CheeseRain client:only="react" />
  <main class="p-4 max-w-4xl mx-auto lg:pt-4 pt-16">
    <header class="prose dark:prose-invert max-w-3xl mx-auto pb-4">
      <div class="flex items-center gap-3 mb-2">
        {
          cheeseImage && (
            <div class:list={["relative", tooltipInfo && "group"]}>
              {
                tooltipInfo ? (
                  <a href="/cave/type-of-notes" class="block">
                    <div class="w-7 h-7 lg:w-11 lg:h-11 flex-shrink-0 -mt-5">
                      <img
                        src={cheeseImage}
                        alt={tooltipInfo.title}
                        class="w-full h-full object-contain cursor-pointer hover:opacity-80 transition-opacity"
                      />
                    </div>
                  </a>
                ) : (
                  <div class="w-7 h-7 lg:w-11 lg:h-11 flex-shrink-0 -mt-5">
                    <img
                      src={cheeseImage}
                      alt=""
                      class="w-full h-full object-contain"
                    />
                  </div>
                )
              }
              {
                tooltipInfo && (
                  <div
                    class="absolute left-full top-1/2 transform -translate-y-1/2 ml-3 px-3 py-2 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50 w-72 shadow-lg"
                  >
                    <div class="font-semibold">{tooltipInfo.title}</div>
                    <div class="text-xs opacity-90 mt-1">
                      {tooltipInfo.description}
                    </div>
                    <div class="text-xs opacity-75 mt-1">
                      Click the cheese icon to learn more
                    </div>
                    <!-- Flecha del tooltip -->
                    <div
                      class="absolute right-full top-1/2 transform -translate-y-1/2 w-0 h-0 border-t-4 border-b-4 border-r-4 border-transparent border-r-gray-900 dark:border-r-gray-100"
                    >
                    </div>
                  </div>
                )
              }
            </div>
          )
        }
        <h1
          class="text-2xl sm:text-3xl lg:text-4xl mt-3 mb-0 leading-tight font-semibold"
        >
          {note.title}
        </h1>
      </div>
      <div
        class="mt-1 mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500/85 dark:text-gray-400/85 font-normal leading-relaxed"
      >
        <span>
          <span class="text-gray-500/60 dark:text-gray-400/60">Author:</span> guiferviz
        </span>
        {
          note.created && (
            <span>
              <span class="text-gray-500/60 dark:text-gray-400/60">
                Created:
              </span>{" "}
              <time datetime={note.created}>
                {format(new Date(note.created), "yyyy-MM-dd")}
              </time>
            </span>
          )
        }
        {
          note.modified && (
            <span>
              <span class="text-gray-500/60 dark:text-gray-400/60">
                Last Modified:
              </span>{" "}
              <time datetime={note.modified}>
                {format(new Date(note.modified), "yyyy-MM-dd")}
              </time>
            </span>
          )
        }
      </div>
    </header>
    <article
      id="note-content"
      class="prose prose-base dark:prose-invert max-w-3xl mx-auto
              prose-headings:font-semibold
              prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg
              prose-h1:mt-[0.8888889em]
              prose-a:hover:underline prose-a:no-underline prose-a:text-yellow-500
              prose-code:after:content-none prose-code:before:content-none"
    >
      <slot />
    </article>
    <footer class="max-w-3xl mx-auto pt-6">
      {
        (note.inboundLinks?.length > 0 || note.outboundLinks?.length > 0) && (
          <section class="mb-8 p-4 bg-gray-50 dark:bg-[#161b22] rounded-lg">
            <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">
              Note Connections
            </h3>
            <div class="grid gap-4 md:grid-cols-2">
              {note.inboundLinks?.length > 0 && (
                <div>
                  <h4 class="font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Linked from ({note.inboundLinks.length})
                  </h4>
                  <ul class="space-y-1">
                    {note.inboundLinks.map((link: any) => (
                      <li class="text-sm">
                        <a
                          href={`/${link.id}`}
                          class="inline-flex items-center gap-1 text-yellow-600 dark:text-yellow-400 hover:underline hover:text-yellow-700 dark:hover:text-yellow-300 transition-colors"
                        >
                          {
                            link.cheeseImage && (
                              <img
                                src={link.cheeseImage}
                                alt=""
                                class="h-4 w-4 shrink-0 object-contain"
                                aria-hidden="true"
                              />
                            )
                          }
                          {link.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {note.outboundLinks?.length > 0 && (
                <div>
                  <h4 class="font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Links to ({note.outboundLinks.length})
                  </h4>
                  <ul class="space-y-1">
                    {note.outboundLinks.map((link: any) => (
                      <li class="text-sm">
                        <a
                          href={`/${link.id}`}
                          class="inline-flex items-center gap-1 text-yellow-600 dark:text-yellow-400 hover:underline hover:text-yellow-700 dark:hover:text-yellow-300 transition-colors"
                        >
                          {
                            link.cheeseImage && (
                              <img
                                src={link.cheeseImage}
                                alt=""
                                class="h-4 w-4 shrink-0 object-contain"
                                aria-hidden="true"
                              />
                            )
                          }
                          {link.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )
      }
      <Giscus />
      <p class="pt-4">© {new Date().getFullYear()} Cheese 🧀 Bytes</p>
    </footer>
  </main>
  <script define:vars={{ noteLinkIcons }}>
    const noteContent = document.getElementById("note-content");
    const iconByHref = new Map();

    for (const noteLink of noteLinkIcons) {
      if (!noteLink.href || !noteLink.cheeseImage) continue;
      iconByHref.set(noteLink.href.replace(/\/+$/, ""), noteLink);
    }

    if (noteContent && iconByHref.size > 0) {
      for (const link of noteContent.querySelectorAll("a[href]")) {
        if (!(link instanceof HTMLAnchorElement)) continue;
        if (link.querySelector(".cheese-note-link-icon")) continue;

        const url = new URL(link.href, window.location.origin);
        if (url.origin !== window.location.origin) continue;

        const noteLink = iconByHref.get(url.pathname.replace(/\/+$/, ""));
        if (!noteLink) continue;

        const icon = document.createElement("img");
        icon.src = noteLink.cheeseImage;
        icon.alt = "";
        icon.setAttribute("aria-hidden", "true");
        icon.className = "cheese-note-link-icon";

        link.classList.add("cheese-note-link");
        link.title ||= noteLink.title || "";
        link.prepend(icon);
      }
    }
  </script>
</BaseLayout>
