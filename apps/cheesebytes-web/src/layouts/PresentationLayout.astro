---
import "../styles/reveal.css";
import BaseHead from "../components/BaseHead.astro";
import DrawingOverlay from "../components/DrawingOverlay.tsx";

export interface Props {
  title?: string;
  description?: string;
  theme?: string;
}

const {
  title = "Cheese Bytes Presentation",
  description = "Hey Bytes, say Cheese!",
  theme = "dark",
} = Astro.props;
---

<!doctype html>
<html lang="es" class={theme}>
  <head>
    <BaseHead title={title} description={description} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/dist/reveal.min.css"
    />
    <!-- Apply a built-in theme.
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js/dist/theme/black.css" />
        -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/dist/reveal.min.js"
    ></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/plugin/notes/notes.min.js"
    ></script>
    <link
      id="highlight-theme"
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.11.1/build/styles/atom-one-dark.min.css"
    />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/plugin/highlight/highlight.min.js"
    ></script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", function () {
        var syncHighlightTheme = function () {
          var themeLink = document.getElementById("highlight-theme");
          if (themeLink) {
            var isDark = document.documentElement.classList.contains("dark");
            var t = isDark ? "atom-one-dark" : "atom-one-light";
            themeLink.href =
              "https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.11.1/build/styles/" +
              t +
              ".min.css";
          }
        };
        syncHighlightTheme();
        // Expose for VimMode theme toggle
        window._syncHighlightTheme = syncHighlightTheme;

        // Initialize Reveal.js (keyboard shortcuts handled by VimMode).
        Reveal.initialize({
          controls: false,
          progress: false,
          minScale: 0.25,
          maxScale: 3,
          margin: 0,
          transition: "fade",
          width: 1080,
          height: 720,
          plugins: [RevealHighlight, RevealNotes],
        });
      });
    </script>

    <!-- VimMode -->
    <script>
      import { createVimMode } from "../utils/vim-mode";
      import cheeseCursor from "../utils/cheese-cursor";

      const vimMedia = window.matchMedia(
        "(max-width: 900px), (pointer: coarse)",
      );

      function destroyVimMode() {
        const vm = (window as any).__vimMode;
        vm?.destroy?.();
        delete (window as any).__vimMode;
        delete (window as any).vimMode;
      }

      function createDesktopVimMode() {
        if ((window as any).__vimMode) return;

        const vm = createVimMode();
        (window as any).__vimMode = vm;
        (window as any).vimMode = vm;

        // Enable cheese cursor by default in presentations
        cheeseCursor.enable();

        const R = () => (window as any).Reveal;

        vm.register("h", {
          label: "Previous slide",
          run: () => R()?.left(),
        });
        vm.register("l", {
          label: "Next slide",
          run: () => R()?.right(),
        });
        vm.register("j", {
          label: "Down / next fragment",
          run: () => R()?.down(),
        });
        vm.register("k", {
          label: "Up / prev fragment",
          run: () => R()?.up(),
        });

        vm.register("t", {
          label: "Toggle theme",
          run: () => {
            document.documentElement.classList.toggle("dark");
            (window as any)._syncHighlightTheme?.();
          },
        });
        vm.register("p", {
          label: "Toggle drawing",
          run: () => window.dispatchEvent(new CustomEvent("toggle-drawing")),
        });
        vm.register("o", {
          label: "Toggle overview",
          run: () => R()?.toggleOverview(),
        });
        vm.register("b", {
          label: "Toggle pause / blackout",
          run: () => R()?.togglePause(),
        });
        vm.register("f", {
          label: "Toggle fullscreen",
          run: () => {
            if (!document.fullscreenElement) {
              document.documentElement.requestFullscreen?.();
            } else {
              document.exitFullscreen?.();
            }
          },
        });

        vm.register("v", {
          label: "Toggle cheese cursor",
          run: () => cheeseCursor.toggle(),
        });

        vm.register("c", {
          label: "Cursor controls…",
          run: () => {
            vm.pushPending({
              id: "cursor",
              commands: [
                {
                  key: "v",
                  label: "Toggle visibility",
                  run: () => cheeseCursor.toggleVisibility(),
                },
                {
                  key: "d",
                  label: "Decrease size",
                  run: () => cheeseCursor.decreaseSize(),
                },
                {
                  key: "e",
                  label: "Enlarge size",
                  run: () => cheeseCursor.increaseSize(),
                },
                {
                  key: "r",
                  label: "Reset size",
                  run: () => cheeseCursor.resetSize(),
                },
              ],
              timeout: 3000,
              label: "Cursor",
            });
          },
        });
      }

      function syncVimMode() {
        if (vimMedia.matches) {
          destroyVimMode();
          return;
        }
        createDesktopVimMode();
      }

      syncVimMode();
      vimMedia.addEventListener("change", syncVimMode);
    </script>
    <!-- The cheese-cursor module manages this style dynamically.
         We keep it here so the presentation never flashes the default cursor. -->
    <style is:inline id="cheese-cursor-hide">
      html,
      body,
      *,
      *:hover,
      *:active,
      *:focus,
      *:focus-visible,
      *:focus-within,
      *::before,
      *::after {
        cursor: none;
      }
    </style>
  </head>
  <body>
    <!-- Drawing overlay currently controlled via Reveal keys (P) emitting 'toggle-drawing' event -->
    <DrawingOverlay
      client:load
      disableCursorStyles={true}
      enableKeyboardShortcut={false}
    />
    <!-- SVG image for the custom cursor, loaded from a URL.
        The CSS cursor property is not used because it does not work well in Chrome.
        It works in Safari, but the image quality is very low. -->
    <img
      id="customCursor"
      src="/cursors/cursor_64.svg"
      alt="Custom Cheese Cursor"
      width="64"
      height="64"
      style="position:fixed;top:0;left:0;pointer-events:none;z-index:10001;transition:opacity 0.3s linear;transform-origin:top left;will-change:transform;opacity:0"
    />
    <div
      class="reveal !max-w-none w-full h-full bg-yellow-50 dark:bg-black text-gray-700 dark:text-gray-100"
    >
      <div class="slides">
        <section>
          <div class="flex flex-col items-center justify-center h-full gap-8">
            <h1 class="text-5xl font-bold">
              {title}
            </h1>
            <p class="text-2xl text-gray-300">
              {description}
            </p>
            <p class="text-lg text-gray-400 mt-8">
              Press <kbd class="px-2 py-1 bg-gray-700 rounded">→</kbd> or <kbd
                class="px-2 py-1 bg-gray-700 rounded">Space</kbd
              > to continue
            </p>
          </div>
        </section>
        <!-- Rest of the slides go here -->
        <slot />
      </div>
    </div>
  </body>
</html>
