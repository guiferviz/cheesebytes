---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroLogo from "../components/HeroLogo.tsx";
import RandomBite from "../components/RandomBite.tsx";

const allNotes = await getCollection("notes");
const noteSummaries = allNotes.map((n) => ({
  id: n.id,
  title: n.data.title,
  description: n.data.description ?? "",
  cheeseImage: n.data.cheeseImage ?? "",
}));
---

<BaseLayout title="Cheese Bytes" description="Programming notes">
  <div class="flex flex-col items-center px-6 text-center gap-8 py-12">
    {/* ── Hero: Interactive Logo Animation ── */}
    <div class="w-full max-w-4xl" style="aspect-ratio: 2080/600;">
      <HeroLogo
        client:load
        width={2080}
        height={600}
        pixelScale={8}
        duration={2700}
      />
    </div>

    {/* ── Taglines ── */}
    <div class="flex flex-col gap-4">
      <p
        class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed"
      >
        A cave of programming puzzles, experiments, and projects.
      </p>
      <p class="text-base sm:text-lg text-gray-500 dark:text-gray-400 italic">
        This is not a feed to scroll mindlessly. <a
          href="/what-is-a-cheese-byte"
          class="underline"
          title="What is Cheese Bytes?">It is</a
        > a place to explore.
      </p>
    </div>

    {/* ── Problems & Projects ── */}
    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 max-w-5xl w-full text-left"
    >
      <a
        href="/projects"
        class="block rounded-xl border border-gray-300 dark:border-gray-700 bg-white/80 dark:bg-gray-900/40 p-6 transition-all hover:border-yellow-600/50 dark:hover:border-yellow-500/50 hover:bg-white dark:hover:bg-gray-900/70 no-underline group shadow-sm hover:shadow-md dark:shadow-none"
      >
        <h2
          class="text-xl font-bold text-yellow-700 dark:text-yellow-400 group-hover:text-yellow-800 dark:group-hover:text-yellow-300 mb-3"
        >
          Projects
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed m-0">
          Full journeys from an initial question to a working system.
        </p>
      </a>

      <a
        href="/programming-problems"
        class="block rounded-xl border border-gray-300 dark:border-gray-700 bg-white/80 dark:bg-gray-900/40 p-6 transition-all hover:border-yellow-600/50 dark:hover:border-yellow-500/50 hover:bg-white dark:hover:bg-gray-900/70 no-underline group shadow-sm hover:shadow-md dark:shadow-none"
      >
        <h2
          class="text-xl font-bold text-yellow-700 dark:text-yellow-400 group-hover:text-yellow-800 dark:group-hover:text-yellow-300 mb-3"
        >
          Problems
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed m-0">
          From classic coding interview challenges to original Cheese Bytes
          creations.
        </p>
      </a>

      <a
        href="/algorithms-and-concepts"
        class="block rounded-xl border border-gray-300 dark:border-gray-700 bg-white/80 dark:bg-gray-900/40 p-6 transition-all hover:border-yellow-600/50 dark:hover:border-yellow-500/50 hover:bg-white dark:hover:bg-gray-900/70 no-underline group shadow-sm hover:shadow-md dark:shadow-none"
      >
        <h2
          class="text-xl font-bold text-yellow-700 dark:text-yellow-400 group-hover:text-yellow-800 dark:group-hover:text-yellow-300 mb-3"
        >
          Algorithms and Concepts
        </h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed m-0">
          Foundational notes about algorithmic thinking, classic techniques and
          the ideas behind the puzzles and experiments across the cave.
        </p>
      </a>
    </div>

    {/* ── Random Bite ── */}
    <div class="flex flex-col items-center gap-4 w-full">
      <p class="text-base text-gray-500 dark:text-gray-400">
        Not sure where to start? Take a random bite from the cave.
      </p>
      <RandomBite client:load notes={noteSummaries} />
    </div>
  </div>
</BaseLayout>
