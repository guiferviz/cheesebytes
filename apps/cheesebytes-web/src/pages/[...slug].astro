---
import NoteLayout from "../layouts/NoteLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: { slug: note.id },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing note slug");
}

const note = await getEntry("notes", slug);

if (!note) {
  throw new Error(`Note not found for slug: ${slug}`);
}

const notes = await getCollection("notes");
const noteLinkIcons = notes
  .map((entry) => ({
    href: `/${entry.id}`,
    cheeseImage:
      typeof entry.data.cheeseImage === "string" ? entry.data.cheeseImage : "",
    noteType: typeof entry.data.noteType === "string" ? entry.data.noteType : "",
    title: typeof entry.data.title === "string" ? entry.data.title : entry.id,
    fileName:
      typeof entry.data.fileName === "string" ? entry.data.fileName : "",
  }))
  .filter((entry) => entry.cheeseImage.length > 0);

const Content = await render(note).then((result) => result.Content);
// Note that rendered is undefined when using MDX files, so marimo won't be inyected on MDX if we don't include the second condition.
const needsMarimo =
  note.rendered?.html.includes("<marimo-island") ||
  note.body?.includes("{.marimo}");
const needsPyodideWorker =
  note.rendered?.html.includes("<pyodide-worker-node") ||
  /```(?:pyodide\b|python[^\n]*\bpyodide\b)/.test(note.body ?? "");
---

<NoteLayout note={note.data} noteLinkIcons={noteLinkIcons}>
  {
    needsMarimo && (
      <>
        <script
          type="module"
          src="https://cdn.jsdelivr.net/npm/@marimo-team/islands@0.13.11-dev10/dist/main.min.js"
        />
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@marimo-team/islands@0.13.11-dev10/dist/style.min.css"
          crossorigin="anonymous"
        />
        <marimo-filename hidden />
      </>
    )
  }
  {
    needsPyodideWorker && (
      <script>import "../scripts/registerPyodideWorkerNode";</script>
    )
  }
  <Content />
</NoteLayout>
