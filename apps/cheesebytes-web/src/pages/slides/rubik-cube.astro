export const naiveCode = dedent`\
    MOVES = {
        "R": [0, 9, 2, 11, 4, 5, 6, 7, 8, 21, 10, 23, 14, 12, 15, 13, 3, 17, 1, 19, 20, 18, 22, 16],
        "D": [0, 1, 2, 3, 4, 5, 18, 19, 8, 9, 6, 7, 12, 13, 10, 11, 16, 17, 14, 15, 22, 20, 23, 21],
        "B": [13, 15, 2, 3, 1, 5, 0, 7, 8, 9, 10, 11, 12, 23, 14, 22, 18, 16, 19, 17, 20, 21, 4, 6],
        "F": [0, 1, 7, 5, 4, 20, 6, 21, 10, 8, 11, 9, 2, 13, 3, 15, 16, 17, 18, 19, 14, 12, 22, 23],
        "U": [2, 0, 3, 1, 8, 9, 6, 7, 12, 13, 10, 11, 16, 17, 14, 15, 4, 5, 18, 19, 20, 21, 22, 23],
        "L": [19, 1, 17, 3, 6, 4, 7, 5, 0, 9, 2, 11, 12, 13, 14, 15, 16, 22, 18, 20, 8, 21, 10, 23],
    }


    def invert_permutation(perm):
        inv = [0] * len(perm)
        for i, p in enumerate(perm):
            inv[p] = i
        return inv


    def compose(p2, p1):
        return [p1[i] for i in p2]


    def get_moves(inverse=True, half_turn=True):
        moves = {}
        for k, v in MOVES.items():
            moves[k] = v
            if inverse:
                moves[k + "'"] = invert_permutation(v)
            if half_turn:
                moves[k + "2"] = compose(v, v)
        return moves


    def apply_move(state, move):
        return "".join(state[i] for i in move)


    def bfs(start, moves, max_depth):
        visited = {start: 0}
        frontier = {start}

        for depth in range(1, max_depth + 1):
            print("Starting Depth", depth)
            next_frontier = set()

            for state in frontier:
                for move in moves.values():
                    nxt = apply_move(state, move)
                    if nxt not in visited:
                        visited[nxt] = depth
                        next_frontier.add(nxt)

            frontier = next_frontier
            print("Finished Depth", depth)
            print("    next frontier size", len(frontier))
            print("    visited so far", len(visited))

        return visited


    def main():
        initial_state = "BBBBRRRRYYYYOOOOWWWWGGGG"
        moves = get_moves(inverse=True, half_turn=True)
        visited = bfs(initial_state, moves, 20)
        counts = {}
        for dist in visited.values():
            counts[dist] = counts.get(dist, 0) + 1
        print("Total states visited:", len(visited))
        print("Move counts by distance:", counts)


    main()`;

export const intRepresentationCode = dedent`\
    from collections import deque
    import math


    HALF_TURN_METRIC = True
    N_PERMUTATIONS = math.factorial(7)
    N_ORIENTATIONS = 3**6
    N_INDICES = N_PERMUTATIONS * N_ORIENTATIONS
    EMPTY_DIST = 255
    MOVES_PERM = {
        "U": [3, 0, 1, 2, 4, 5, 6],
        "F": [0, 1, 3, 4, 5, 2, 6],
        "R": [0, 2, 5, 3, 4, 6, 1],
    }
    MOVES_ORI = {
        "U": [0, 0, 0, 0, 0, 0],
        "F": [0, 0, 1, 2, 1, 2],
        "R": [0, 1, 2, 0, 0, 1],
    }


    def invert_perm(perm):
        inv = [0] * len(perm)
        for i, p in enumerate(perm):
            inv[p] = i
        return inv


    def compose(perm2, perm1):
        return [perm1[i] for i in perm2]


    for k in list(MOVES_PERM.keys()):
        MOVES_PERM[k + "'"] = invert_perm(MOVES_PERM[k])
        MOVES_ORI[k + "'"] = MOVES_ORI[k].copy()
        if HALF_TURN_METRIC:
            MOVES_PERM[k + "2"] = compose(MOVES_PERM[k], MOVES_PERM[k])
            MOVES_ORI[k + "2"] = [0] * 6
    MOVES = list(MOVES_PERM.keys())
    assert list(MOVES_ORI.keys()) == MOVES


    def index_to_lehmer(perm_index: int) -> list[int]:
        n = 7
        code = [0] * n
        for i in range(2, n + 1):
            code[-i] = perm_index % i
            perm_index //= i
        return code


    def lehmer_to_perm(lehmer: list[int]) -> list[int]:
        n = 7
        perm = lehmer.copy()
        for i in range(n - 1, -1, -1):
            for j in range(i + 1, n):
                if perm[j] >= perm[i]:
                    perm[j] += 1
        return perm


    def decode_perm(perm_index: int) -> list[int]:
        lehmer = index_to_lehmer(perm_index)
        perm = lehmer_to_perm(lehmer)
        return perm


    def apply_perm(state, perm) -> list[int]:
        return [state[i] for i in perm]


    def lehmer_to_index(lehmer: list[int]) -> int:
        result = 0
        fact = 1
        for i, value in enumerate(reversed(lehmer), start=1):
            result += value * fact
            fact *= i
        return result


    def perm_to_lehmer(perm: list[int]) -> list[int]:
        for i in range(len(perm)):
            for j in range(i + 1, len(perm)):
                if perm[j] > perm[i]:
                    perm[j] -= 1
        return perm


    def encode_perm(perm: list[int]) -> int:
        lehmer = perm_to_lehmer(perm)
        index = lehmer_to_index(lehmer)
        return index


    def apply_move_to_perm_index(perm_index, move) -> int:
        perm = decode_perm(perm_index)
        new_perm = apply_perm(perm, MOVES_PERM[move])
        return encode_perm(new_perm)


    def apply_ori(ori, move):
        new_ori = [0] * 6
        for i in range(6):
            new_ori[i] = (ori[i] + move[i]) % 3
        return new_ori


    def apply_move_to_ori_index(ori_index, move) -> int:
        ori = decode_ori(ori_index)
        ori = apply_perm(ori, MOVES_PERM[move])
        new_ori = apply_ori(ori, MOVES_ORI[move])
        return encode_ori(new_ori)


    def split_index(index: int) -> tuple[int, int]:
        perm_index = index // N_ORIENTATIONS
        ori_index = index % N_ORIENTATIONS
        return perm_index, ori_index


    def decode_ori(ori_index: int) -> list[int]:
        result = [0] * 7
        for i in range(6):
            result[i] = ori_index % 3
            ori_index //= 3
        result[-1] = -sum(result) % 3
        return result


    def encode_ori(ori: list[int]) -> int:
        result = 0
        pos = 1
        for i in range(6):
            result += ori[i] * pos
            pos *= 3
        return result


    def combine_indices(perm_index: int, ori_index: int) -> int:
        return perm_index * N_ORIENTATIONS + ori_index


    def create_perm_table() -> dict[str, list[int]]:
        table = {i: [0] * N_PERMUTATIONS for i in MOVES}
        for move in MOVES:
            for p in range(N_PERMUTATIONS):
                table[move][p] = apply_move_to_perm_index(p, move)
        return table


    def create_ori_table() -> dict[str, list[int]]:
        table = {i: [0] * N_ORIENTATIONS for i in MOVES}
        for move in MOVES:
            for o in range(N_ORIENTATIONS):
                table[move][o] = apply_move_to_ori_index(o, move)
        return table


    def neighbors(state, perm_table, ori_table):
        for m in perm_table.keys():
            perm_index, ori_index = split_index(state)
            new_perm_index = perm_table[m][perm_index]
            new_ori_index = ori_table[m][ori_index]
            yield combine_indices(new_perm_index, new_ori_index)


    def bfs(initial_index, max_depth, perm_table, ori_table):
        dist = bytearray([EMPTY_DIST]) * N_INDICES
        dist[initial_index] = 0
        queue = deque([initial_index])
        while queue:
            index = queue.popleft()
            depth = dist[index]
            next_depth = depth + 1
            for i in neighbors(index, perm_table, ori_table):
                if dist[i] != EMPTY_DIST:
                    continue
                dist[i] = next_depth
                if next_depth <= max_depth:
                    queue.append(i)
        return dist


    def dist_count(dist: bytearray):
        counts = {i: 0 for i in range(256)}
        for i in range(N_INDICES):
            counts[dist[i]] += 1
        return {k: v for k, v in counts.items() if v >= 1}


    def main():
        perm_table = create_perm_table()  # 5040
        ori_table = create_ori_table()  # 729
        solved_state = 0
        max_depth = 16
        dist = bfs(solved_state, max_depth, perm_table, ori_table)
        print(dist_count(dist))


    main()`;

export const vectorizedCode = dedent`\
    import math
    import time

    import numpy as np


    HALF_TURN_METRIC = True
    N_PERMUTATIONS = math.factorial(7)
    N_ORIENTATIONS = 3**6
    N_INDICES = N_PERMUTATIONS * N_ORIENTATIONS
    EMPTY_DIST = 255
    MOVES_PERM = {
        "U": [3, 0, 1, 2, 4, 5, 6],
        "F": [0, 1, 3, 4, 5, 2, 6],
        "R": [0, 2, 5, 3, 4, 6, 1],
    }
    MOVES_ORI = {
        "U": [0, 0, 0, 0, 0, 0],
        "F": [0, 0, 1, 2, 1, 2],
        "R": [0, 1, 2, 0, 0, 1],
    }


    def invert_perm(perm):
        inv = [0] * len(perm)
        for i, p in enumerate(perm):
            inv[p] = i
        return inv


    def compose(perm2, perm1):
        return [perm1[i] for i in perm2]


    for k in list(MOVES_PERM.keys()):
        MOVES_PERM[k + "'"] = invert_perm(MOVES_PERM[k])
        MOVES_ORI[k + "'"] = MOVES_ORI[k].copy()
        if HALF_TURN_METRIC:
            MOVES_PERM[k + "2"] = compose(MOVES_PERM[k], MOVES_PERM[k])
            MOVES_ORI[k + "2"] = [0] * 6
    MOVES = list(MOVES_PERM.keys())
    assert list(MOVES_ORI.keys()) == MOVES


    def index_to_lehmer(perm_index: int) -> list[int]:
        n = 7
        code = [0] * n
        for i in range(2, n + 1):
            code[-i] = perm_index % i
            perm_index //= i
        return code


    def lehmer_to_perm(lehmer: list[int]) -> list[int]:
        n = 7
        perm = lehmer.copy()
        for i in range(n - 1, -1, -1):
            for j in range(i + 1, n):
                if perm[j] >= perm[i]:
                    perm[j] += 1
        return perm


    def decode_perm(perm_index: int) -> list[int]:
        lehmer = index_to_lehmer(perm_index)
        perm = lehmer_to_perm(lehmer)
        return perm


    def apply_perm(state, perm) -> list[int]:
        return [state[i] for i in perm]


    def lehmer_to_index(lehmer: list[int]) -> int:
        result = 0
        fact = 1
        for i, value in enumerate(reversed(lehmer), start=1):
            result += value * fact
            fact *= i
        return result


    def perm_to_lehmer(perm: list[int]) -> list[int]:
        for i in range(len(perm)):
            for j in range(i + 1, len(perm)):
                if perm[j] > perm[i]:
                    perm[j] -= 1
        return perm


    def encode_perm(perm: list[int]) -> int:
        lehmer = perm_to_lehmer(perm)
        index = lehmer_to_index(lehmer)
        return index


    def apply_move_to_perm_index(perm_index, move) -> int:
        perm = decode_perm(perm_index)
        new_perm = apply_perm(perm, MOVES_PERM[move])
        return encode_perm(new_perm)


    def apply_ori(ori, move):
        new_ori = [0] * 6
        for i in range(6):
            new_ori[i] = (ori[i] + move[i]) % 3
        return new_ori


    def apply_move_to_ori_index(ori_index, move) -> int:
        ori = decode_ori(ori_index)
        ori = apply_perm(ori, MOVES_PERM[move])
        new_ori = apply_ori(ori, MOVES_ORI[move])
        return encode_ori(new_ori)


    def split_index(index: int) -> tuple[int, int]:
        perm_index = index // N_ORIENTATIONS
        ori_index = index % N_ORIENTATIONS
        return perm_index, ori_index


    def decode_ori(ori_index: int) -> list[int]:
        result = [0] * 7
        for i in range(6):
            result[i] = ori_index % 3
            ori_index //= 3
        result[-1] = -sum(result) % 3
        return result


    def encode_ori(ori: list[int]) -> int:
        result = 0
        pos = 1
        for i in range(6):
            result += ori[i] * pos
            pos *= 3
        return result


    def combine_indices(perm_index: int, ori_index: int) -> int:
        return perm_index * N_ORIENTATIONS + ori_index


    def create_perm_table() -> np.ndarray:
        n_moves = len(MOVES)
        table = np.zeros((n_moves, N_PERMUTATIONS), dtype=np.uint16)
        for m_idx, move in enumerate(MOVES):
            for p in range(N_PERMUTATIONS):
                table[m_idx, p] = apply_move_to_perm_index(p, move)
        return table


    def create_ori_table() -> np.ndarray:
        n_moves = len(MOVES)
        table = np.zeros((n_moves, N_ORIENTATIONS), dtype=np.uint16)
        for m_idx, move in enumerate(MOVES):
            for o in range(N_ORIENTATIONS):
                table[m_idx, o] = apply_move_to_ori_index(o, move)
        return table


    def bfs(initial_index, max_depth, perm_table, ori_table):
        dist = np.full(N_INDICES, EMPTY_DIST, dtype=np.uint8)
        dist[initial_index] = 0
        frontier = np.array([initial_index], dtype=np.uint32)
        n_moves = perm_table.shape[0]

        for depth in range(max_depth + 1):
            if len(frontier) == 0:
                break

            perm_idx = frontier // N_ORIENTATIONS
            ori_idx = frontier % N_ORIENTATIONS

            next_parts = []
            for m in range(n_moves):
                new_perm = perm_table[m, perm_idx].astype(np.uint32)
                new_ori = ori_table[m, ori_idx].astype(np.uint32)
                neighbors = new_perm * N_ORIENTATIONS + new_ori
                mask = dist[neighbors] == EMPTY_DIST
                new_states = neighbors[mask]
                if len(new_states) > 0:
                    dist[new_states] = depth + 1
                    next_parts.append(new_states)

            frontier = (
                np.concatenate(next_parts) if next_parts else np.empty(0, dtype=np.uint32)
            )

        return dist


    def dist_count(dist: np.ndarray):
        counts = np.bincount(dist, minlength=256)
        return {int(i): int(c) for i, c in enumerate(counts) if c > 0}


    def main():
        t_start = time.perf_counter()

        perm_table = create_perm_table()  # 5040
        ori_table = create_ori_table()  # 729
        t_tables = time.perf_counter()
        print(f"Tables built in {t_tables - t_start:.3f}s")

        solved_state = 0
        max_depth = 16
        dist = bfs(solved_state, max_depth, perm_table, ori_table)
        t_bfs = time.perf_counter()
        print(f"BFS done in    {t_bfs - t_tables:.3f}s")
        print(f"Total time     {t_bfs - t_start:.3f}s")

        print(dist_count(dist))


    main()`;
