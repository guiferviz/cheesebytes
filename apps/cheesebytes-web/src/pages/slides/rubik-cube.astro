---
import dedent from "dedent";

import RevealLayout from "../../layouts/PresentationLayout.astro";
import { RubikCube as RubikCubeViz } from "../../components/cave/rubik-cube";
import { LogoAnimation } from "../../components/cave/intro";
import PyodideWorkerRunner from "../../../src/components/PyodideWorkerRunner";

export const exampleCode = dedent`\
    import asyncio

    MOVES = {
        "F": [0, 1, 7, 5, 4, 20, 6, 21, 10, 8, 11, 9, 2, 13, 3, 15, 16, 17, 18, 19, 14, 12, 22, 23],
        "U": [2, 0, 3, 1, 8, 9, 6, 7, 12, 13, 10, 11, 16, 17, 14, 15, 4, 5, 18, 19, 20, 21, 22, 23],
        "R": [0, 9, 2, 11, 4, 5, 6, 7, 8, 21, 10, 23, 14, 12, 15, 13, 16, 1, 18, 3, 20, 17, 22, 19],
        "L": [16, 1, 18, 3, 6, 4, 7, 5, 0, 9, 2, 11, 12, 13, 14, 15, 22, 17, 20, 19, 8, 21, 10, 23],
        "D": [0, 1, 2, 3, 4, 5, 10, 11, 8, 9, 14, 15, 12, 13, 18, 19, 16, 17, 6, 7, 22, 20, 23, 21],
        "B": [13, 15, 2, 3, 1, 5, 0, 7, 8, 9, 10, 11, 12, 23, 14, 22, 18, 16, 19, 17, 20, 21, 4, 6],
    }

    def invert_permutation(perm):
        inv = [0] * len(perm)
        for i, p in enumerate(perm):
            inv[p] = i
        return inv

    for k in list(MOVES.keys()):
        MOVES[k + "'"] = invert_permutation(MOVES[k])

    def move(state, move):
        return "".join(state[i] for i in MOVES[move])

    def explore_moves(state, max_depth):
        visited = {}
        def dfs(current_state, depth):
            if depth > max_depth or current_state in visited:
                return
            visited[current_state] = depth
            for move_name in MOVES.keys():
                next_state = move(current_state, move_name)
                dfs(next_state, depth + 1)
        dfs(state, 0)
        return visited

    initial_state = "BBBBRRRRYYYYOOOOWWWWGGGG"
    visited = explore_moves(initial_state, 1)
    counts = {}
    for dist in visited.values():
        counts[dist] = counts.get(dist, 0) + 1
    print("Total states visited:", len(visited))
    print("Move counts by distance:", counts)`;
---

<RevealLayout
  title="The Rubik's Cube"
  description="Efficient representations and traversal of the Rubik's Cube state space"
  theme="dark"
>
  <section>
    <aside class="notes">
      <p>
        This is a Rubik's Cube. Six faces, nine stickers each, fifty-four
        colours in total. You have probably held one at some point. Maybe you
        solved it once. Maybe you gave up, peeled the stickers off, and called
        it a day.
      </p>
      <p>
        Today we are not going to talk about how to solve it using our fingers,
        but using a computer.
      </p>
    </aside>
    Hook
  </section>

  <section id="intro">
    <LogoAnimation
      client:load
      width={2080}
      height={600}
      pixelScale={8}
      duration={2700}
      loop={true}
    />
  </section>

  <section id="cube">
    <aside class="notes">
      <p>
        The first step is to represent the cube in a way that a computer can
        understand. We need to encode the state of the cube — which stickers are
        where — into a data structure. There are many ways to do this, but a
        straightforward approach is to use a string of characters, where each
        character represents a sticker's colour and position. For example, we
        can list the stickers in a specific order. This way, we can easily
        manipulate the string to simulate moves and track the cube's state as we
        solve it.
      </p>
    </aside>
    <RubikCubeViz
      client:only="react"
      width={1080}
      height={720}
      showStateEditor={true}
    />
  </section>

  <section>
    <aside class="notes">
      <p></p>
    </aside>
    <PyodideWorkerRunner client:only="react" initialCode={exampleCode} />
  </section>
</RevealLayout>
