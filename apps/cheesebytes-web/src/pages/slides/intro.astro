---
import RevealLayout from "../../layouts/PresentationLayout.astro";
import { LogoAnimation } from "../../components/cave/intro";
import { CB } from "../../styles/palette";

const palette = [
  { name: "White", hex: CB.white, rgb: "254, 254, 254" },
  { name: "Brown", hex: CB.brown, rgb: "147, 50, 9" },
  { name: "Red Orange", hex: CB.redOrange, rgb: "254, 118, 1" },
  { name: "Orange", hex: CB.orange, rgb: "254, 171, 2" },
  { name: "Yellow", hex: CB.yellow, rgb: "252, 229, 1" },
  { name: "Black", hex: CB.black, rgb: "0, 0, 0" },
];
---

<RevealLayout
  title="Cheese Bytes – Intro"
  description="Pixel-art logo animation intro"
  theme="dark"
>
  <section id="logo">
    <LogoAnimation
      client:load
      width={2080}
      height={600}
      pixelScale={8}
      duration={2700}
      loop={true}
    />
  </section>

  <section id="palette" data-background-color="#000">
    <div
      class="h-full w-full flex flex-col items-center justify-center gap-10 px-12"
    >
      <h2 class="text-5xl md:text-6xl font-bold tracking-wide text-white">
        Cheese Bytes Palette
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-10">
        {
          palette.map((c) => (
            <div class="flex flex-col items-center gap-3">
              <div
                class="w-36 h-36 md:w-40 md:h-40 rounded-full border-4 border-white/20 shadow-[0_0_40px_rgba(255,255,255,0.12)]"
                style={`background:${c.hex};`}
              />
              <div class="text-center leading-tight">
                <div class="text-lg font-semibold text-white">{c.name}</div>
                <div class="text-sm text-stone-300 uppercase">{c.hex}</div>
                <div class="text-xs text-stone-400">RGB {c.rgb}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</RevealLayout>
