---
import RevealLayout from "../../layouts/PresentationLayout.astro";
import {
  PeriodicTable as PeriodicTableContainer,
  ElementalNamesTree as ElementTree,
  ElementalNamesSingleChar as ArrayVisualizer,
  ElementalNamesAllPossibilities,
  ComplexityBenchmark,
} from "../../components/cave/nombres-elementales";
import RevealCode from "../../components/RevealCode";
---

<RevealLayout
  title="Nombres Elementales"
  description="Forma nombres con las iniciales de los elementos químicos"
  theme="dark"
>
  <section>
    <ArrayVisualizer client:visible />
  </section>
  <section>
    <PeriodicTableContainer client:load />
  </section>
  <section style={{ height: "60vh" }}>
    <ElementalNamesAllPossibilities initialText="Coco" client:load />
  </section>
  <section>
    <div style={{ height: "70vh" }}>
      <ElementTree showInput={true} client:load />
    </div>
  </section>
  <section id="code-final" class="text-left text-sm">
    <RevealCode
      client:only="react"
      animation="typing"
      code={`# STEP-0
ELEMENTS = {
    'H','He',
    'Li','Be','B','C','N','O','F','Ne',
    'Na','Mg','Al','Si','P','S','Cl','Ar',
    'K','Ca','Sc','Ti','V','Cr','Mn','Fe','Co','Ni','Cu','Zn','Ga','Ge','As','Se','Br','Kr',
    'Rb','Sr','Y','Zr','Nb','Mo','Tc','Ru','Rh','Pd','Ag','Cd','In','Sn','Sb','Te','I','Xe',
    'Cs','Ba','La','Ce','Pr','Nd','Pm','Sm','Eu','Gd','Tb','Dy','Ho','Er','Tm','Yb','Lu',
    'Hf','Ta','W','Re','Os','Ir','Pt','Au','Hg','Tl','Pb','Bi','Po','At','Rn',
    'Fr','Ra','Ac','Th','Pa','U','Np','Pu','Am','Cm','Bk','Cf','Es','Fm','Md','No','Lr',
    'Rf','Db','Sg','Bh','Hs','Mt','Ds','Rg','Cn','Fl','Lv','Ts','Og'
}

def is_elemental(name: str) -> bool:
    # STEP-1
    if name == "":
        return True

    # STEP-2
    if name[:1] in ELEMENTS and is_elemental(name[1:]):
        return True

    # STEP-3
    if len(name) >= 2 and name[:2] in ELEMENTS and is_elemental(name[2:]):
        return True
    # STEP-0

    return False`}
    />
  </section>

  <section id="wip">
    <ComplexityBenchmark
      client:visible
      title="String Slicing Complexity"
      xAxisLabel="Input Size (characters)"
      yAxisLabel="Time (ms)"
      inputGenerator={`from random import random
  
def create_input(x):
    return "C" * x`}
      algorithms={[
        {
          id: "slicing",
          name: "slicing (O(n²))",
          functionName: "slicing",
          code: `def slicing(name: str) -> int:
    steps = 0
    while name:
        name = name[1:]  # copies almost the entire string
        steps += 1
    return steps`,
        },
        {
          id: "counting",
          name: "counting (O(n))",
          functionName: "counting",
          code: `def counting(name: str) -> int:
    steps = 0
    for char in name:
        steps += 1
    return steps`,
        },
        {
          id: "counting1",
          name: "counting (O(n))",
          functionName: "counting",
          code: `def counting(name: str) -> int:
    steps = 0
    for char in name:
        steps += 1
    return steps`,
        },
        {
          id: "counting2",
          name: "counting (O(n))",
          functionName: "counting",
          code: `def counting(name: str) -> int:
    steps = 0
    for char in name:
        steps += 1
    return steps`,
        },
        {
          id: "counting3",
          name: "counting (O(n))",
          functionName: "counting",
          code: `def counting(name: str) -> int:
    steps = 0
    for char in name:
        steps += 1
    return steps`,
        },
      ]}
      startX={1}
      stepX={1000}
      maxXLimit={1000000}
    />
  </section>
</RevealLayout>
