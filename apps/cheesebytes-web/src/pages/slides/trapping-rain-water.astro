---
import RevealLayout from "../../layouts/PresentationLayout.astro";
import {
  TrappingWater,
  DEFAULT_HEIGHTS,
} from "../../components/cave/trapping-rain-water";
---

<RevealLayout
  title="Trapping Rain Water"
  description="Two-pointer algorithm visualization with pixel art sprites"
  theme="dark"
>
  <!-- Slide 1: Title -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-8">
      <h1 class="text-5xl font-bold">🎮 Trapping Rain Water</h1>
      <p class="text-2xl text-amber-300">
        <strong>Pixel Art Edition</strong>
      </p>
      <p class="text-xl text-gray-300 mt-4">
        A visual guide to the <strong>two-pointer</strong> algorithm
      </p>
      <p class="text-lg text-gray-400 mt-8">
        Press <kbd class="px-2 py-1 bg-gray-700 rounded">→</kbd> or <kbd
          class="px-2 py-1 bg-gray-700 rounded">Space</kbd
        > to continue
      </p>
    </div>
  </section>

  <!-- Slide 2: The World -->
  <section>
    <TrappingWater
      client:load
      heights={DEFAULT_HEIGHTS}
      showAlgorithm={false}
      showWaterPreview={false}
      showControls={false}
      showRain={false}
      scale={0.375}
    />
  </section>

  <!-- Slide 3: Rain Preview -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">When It Rains...</h2>
      <TrappingWater
        client:load
        title="💧 Water fills the gaps!"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={false}
        showWaterPreview={true}
        showControls={false}
        showRain={true}
        scale={0.375}
      />
      <p class="text-xl text-gray-300 mt-4 fragment">
        Water <span class="text-blue-400">fills</span> the spaces between blocks
      </p>
    </div>
  </section>

  <!-- Slide 4: The Challenge -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-8">
      <h2 class="text-4xl font-bold">🎯 The Challenge</h2>
      <div class="text-2xl text-gray-300 space-y-4 text-center max-w-3xl">
        <p class="fragment">
          Given the height of each <span class="text-amber-400"
            >terrain column</span
          >...
        </p>
        <p class="fragment">
          Calculate how many <span class="text-blue-400">water blocks</span> get trapped!
        </p>
        <p class="fragment fade-up text-amber-300 font-mono mt-8">
          heights = [0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]
        </p>
      </div>
    </div>
  </section>

  <!-- Slide 5: Two Pointers Concept -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <p class="text-xl text-gray-300 mb-4">
        <span class="text-green-400">L</span> starts left,
        <span class="text-amber-400">R</span> starts right - they march toward each
        other!
      </p>
      <TrappingWater
        client:load
        title="Two-Pointer Algorithm"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={true}
        showWaterPreview={false}
        showControls={true}
        autoPlay={false}
        autoPlayDelay={600}
        scale={0.375}
      />
    </div>
  </section>

  <!-- Slide 6: Algorithm Rules -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-8">
      <h2 class="text-4xl font-bold">📜 Game Rules</h2>
      <div class="grid grid-cols-2 gap-8 text-xl">
        <div class="bg-green-900/30 p-6 rounded-xl border border-green-500/30">
          <h3 class="text-2xl font-bold text-green-400 mb-4">
            🟢 Left Pointer
          </h3>
          <ul class="space-y-2 text-gray-300">
            <li>• Tracks <code class="text-green-300">leftMax</code></li>
            <li>• Moves when leftMax ≤ rightMax</li>
            <li>• Adds water: leftMax - height</li>
          </ul>
        </div>
        <div class="bg-amber-900/30 p-6 rounded-xl border border-amber-500/30">
          <h3 class="text-2xl font-bold text-amber-400 mb-4">
            🟡 Right Pointer
          </h3>
          <ul class="space-y-2 text-gray-300">
            <li>• Tracks <code class="text-amber-300">rightMax</code></li>
            <li>• Moves when rightMax &lt; leftMax</li>
            <li>• Adds water: rightMax - height</li>
          </ul>
        </div>
      </div>
      <p class="text-lg text-gray-400 mt-4 fragment">
        The pointers meet in the middle → <span class="text-emerald-400"
          >Game Complete!</span
        >
      </p>
    </div>
  </section>

  <!-- Slide 7: Interactive Demo -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">🕹️ Try It Yourself!</h2>
      <TrappingWater
        client:load
        title="Interactive Demo"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={true}
        showWaterPreview={false}
        showControls={true}
        autoPlay={false}
        scale={0.375}
      />
      <p class="text-lg text-gray-400 mt-2">
        Click <strong>Step</strong> to advance, or <strong>Play</strong> to watch
        it run!
      </p>
    </div>
  </section>

  <!-- Slide 8: Auto-play Demo -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">🎬 Watch It Run</h2>
      <TrappingWater
        client:load
        title="Auto-play Mode"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={true}
        showWaterPreview={false}
        showControls={true}
        autoPlay={true}
        autoPlayDelay={500}
        scale={0.375}
      />
    </div>
  </section>

  <!-- Slide 9: Different Heights -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">🗻 Different Terrain</h2>
      <TrappingWater
        client:load
        title="A Taller World"
        heights={[3, 0, 2, 0, 4, 0, 1, 0, 3, 0, 2]}
        showAlgorithm={true}
        showWaterPreview={false}
        showControls={true}
        autoPlay={false}
        scale={0.3125}
      />
    </div>
  </section>

  <!-- Slide 10: Code -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-3xl font-bold">💻 The Code</h2>
      <pre
        class="text-lg bg-gray-900 p-6 rounded-xl shadow-xl"><code class="language-python">{`def trap(height):
    if not height:
        return 0
    
    left, right = 0, len(height) - 1
    left_max = right_max = 0
    water = 0
    
    while left < right:
        if height[left] <= height[right]:
            if height[left] >= left_max:
                left_max = height[left]
            else:
                water += left_max - height[left]
            left += 1
        else:
            if height[right] >= right_max:
                right_max = height[right]
            else:
                water += right_max - height[right]
            right -= 1
    
    return water`}</code></pre>
      <p class="text-xl text-gray-300">
        Time: <span class="text-green-400">O(n)</span> • Space: <span
          class="text-green-400">O(1)</span
        >
      </p>
    </div>
  </section>

  <!-- Slide 11: Summary -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-8">
      <h2 class="text-4xl font-bold">🏆 Level Complete!</h2>
      <div class="text-2xl text-gray-300 space-y-4 text-center">
        <p>✅ Two pointers start at opposite ends</p>
        <p>✅ Track max height seen from each side</p>
        <p>✅ Move the pointer with smaller max</p>
        <p>✅ Add trapped water at each step</p>
      </div>
      <p class="text-xl text-amber-300 mt-8">Thanks for playing! 🎮</p>
    </div>
  </section>
</RevealLayout>
