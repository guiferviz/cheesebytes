---
import RevealLayout from "../../layouts/PresentationLayout.astro";
import {
  TrappingWater,
  DEFAULT_HEIGHTS,
} from "../../components/cave/trapping-rain-water";
---

<RevealLayout
  title="Trapping Rain Water"
  description="Two-pointer algorithm visualization"
  theme="dark"
>
  <!-- Slide 1: Title -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-8">
      <h1 class="text-5xl font-bold">🌧️ Trapping Rain Water</h1>
      <p class="text-2xl text-gray-300">
        A visual guide to the <strong>two-pointer</strong> algorithm
      </p>
      <p class="text-lg text-gray-400 mt-8">
        Press <kbd class="px-2 py-1 bg-gray-700 rounded">→</kbd> or <kbd
          class="px-2 py-1 bg-gray-700 rounded">Space</kbd
        > to continue
      </p>
    </div>
  </section>

  <!-- Slide 2: The Map -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">The Terrain</h2>
      <TrappingWater
        client:load
        title="Given a height map..."
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={false}
        showWaterPreview={false}
        showControls={false}
      />
      <p class="text-xl text-gray-300 mt-4 fragment">
        How much water gets <strong>trapped</strong> when it rains?
      </p>
    </div>
  </section>

  <!-- Slide 3: Rain Preview -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">When It Rains...</h2>
      <TrappingWater
        client:load
        title="Water fills the valleys"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={false}
        showRain={true}
        showWaterPreview={true}
        showControls={false}
      />
    </div>
  </section>

  <!-- Slide 4: Physical Intuition -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">The Physical Rule</h2>
      <p class="text-2xl text-gray-300 fragment">
        Water accumulates where there are <strong>walls on both sides</strong>
      </p>
      <p class="text-xl text-gray-400 fragment mt-4">
        The water level at any point is limited by the <strong
          >shorter wall</strong
        >
      </p>
    </div>
  </section>

  <!-- Slide 5: The Formula -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-4">
      <h2 class="text-3xl font-bold mb-2">The Formula</h2>
      <TrappingWater
        client:load
        title="Water at column i"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={false}
        showWaterPreview={true}
        showControls={false}
        highlightColumn={5}
        showFormula={true}
      />
      <div
        class="text-xl text-gray-300 mt-4 font-mono bg-gray-800 px-6 py-3 rounded-lg"
      >
        water[i] = min(leftMax, rightMax) - height[i]
      </div>
    </div>
  </section>

  <!-- Slide 6: Why Two Pointers? -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">Why Two Pointers?</h2>
      <div class="text-2xl text-gray-300 space-y-4">
        <p class="fragment">
          ❌ Naive: For each column, scan left AND right → O(n²)
        </p>
        <p class="fragment">
          ✓ Prefix arrays: Precompute leftMax[] and rightMax[] → O(n) space
        </p>
        <p class="fragment">
          ✓✓ <strong class="text-amber-400">Two pointers</strong>: O(n) time,
          O(1) space!
        </p>
      </div>
    </div>
  </section>

  <!-- Slide 7: Algorithm Intro -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">Two-Pointer Strategy</h2>
      <div class="grid grid-cols-2 gap-8 text-xl text-gray-300">
        <div class="fragment bg-green-900/30 p-4 rounded-lg">
          <div class="text-green-400 font-bold mb-2">L pointer</div>
          <p>Tracks position from left</p>
          <p>Updates <code>leftMax</code></p>
        </div>
        <div class="fragment bg-amber-900/30 p-4 rounded-lg">
          <div class="text-amber-400 font-bold mb-2">R pointer</div>
          <p>Tracks position from right</p>
          <p>Updates <code>rightMax</code></p>
        </div>
      </div>
      <p class="text-xl text-gray-400 fragment mt-4">
        Process the side with the <strong>smaller</strong> max value
      </p>
    </div>
  </section>

  <!-- Slide 8: The Key Insight -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">The Key Insight</h2>
      <div class="text-2xl text-gray-300 max-w-3xl text-center space-y-4">
        <p class="fragment">
          If <code class="text-green-400">leftMax ≤ rightMax</code>:
        </p>
        <p class="fragment text-xl text-gray-400">
          The water at L is bounded by leftMax (we don't need exact rightMax!)
        </p>
        <p class="fragment mt-6">
          If <code class="text-amber-400">rightMax < leftMax</code>:
        </p>
        <p class="fragment text-xl text-gray-400">
          The water at R is bounded by rightMax (we don't need exact leftMax!)
        </p>
      </div>
    </div>
  </section>

  <!-- Slide 9: Algorithm Demo -->
  <section>
    <div class="flex flex-col items-center justify-center h-full">
      <TrappingWater
        client:load
        title="Two-Pointer Algorithm"
        heights={DEFAULT_HEIGHTS}
        showAlgorithm={true}
        showControls={true}
        showMaxMarkers={true}
      />
    </div>
  </section>

  <!-- Slide 10: Why It Works -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">Why Does It Work?</h2>
      <div class="text-xl text-gray-300 max-w-3xl space-y-4">
        <p class="fragment">
          🔑 When <code>leftMax ≤ rightMax</code>, we process L:
        </p>
        <p class="fragment text-gray-400 pl-8">
          Even if the true right max is higher, our answer is still correct
          because water is bounded by the <strong>minimum</strong> of both sides.
        </p>
        <p class="fragment mt-4">
          🔑 We always have one "guaranteed" boundary:
        </p>
        <p class="fragment text-gray-400 pl-8">
          The side we're NOT processing has a max ≥ our current max.
        </p>
      </div>
    </div>
  </section>

  <!-- Slide 11: Common Mistakes Intro -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold text-red-400">Common Mistakes</h2>
      <p class="text-2xl text-gray-300">Why simpler approaches fail...</p>
    </div>
  </section>

  <!-- Slide 12: Mistake - Only Left -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-3xl font-bold">❌ Looking Only Left</h2>
      <p class="text-xl text-gray-300">
        If we only track <code>leftMax</code>:
      </p>
      <div class="bg-red-900/30 p-6 rounded-lg max-w-2xl">
        <p class="text-gray-300">At column with height 1, leftMax = 3</p>
        <p class="text-gray-300 mt-2">
          We'd add water = 3 - 1 = 2... but maybe rightMax is only 1!
        </p>
        <p class="text-red-400 font-bold mt-4">
          → Water would "overflow" to the right
        </p>
      </div>
    </div>
  </section>

  <!-- Slide 13: Mistake - Only Right -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-3xl font-bold">❌ Looking Only Right</h2>
      <p class="text-xl text-gray-300">Same problem in reverse!</p>
      <div class="bg-red-900/30 p-6 rounded-lg max-w-2xl">
        <p class="text-gray-400">
          You need <strong>both</strong> boundaries, or a clever way to guarantee
          one.
        </p>
        <p class="text-green-400 font-bold mt-4">
          → Two pointers gives us that guarantee!
        </p>
      </div>
    </div>
  </section>

  <!-- Slide 14: Code -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-3xl font-bold">The Code</h2>
      <pre
        class="text-sm bg-gray-900 p-6 rounded-lg overflow-x-auto"><code class="language-python">{`def trap(height):
    if not height:
        return 0
    
    left, right = 0, len(height) - 1
    left_max = right_max = 0
    water = 0
    
    while left < right:
        if height[left] <= height[right]:
            if height[left] >= left_max:
                left_max = height[left]
            else:
                water += left_max - height[left]
            left += 1
        else:
            if height[right] >= right_max:
                right_max = height[right]
            else:
                water += right_max - height[right]
            right -= 1
    
    return water`}</code></pre>
    </div>
  </section>

  <!-- Slide 15: Complexity -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">Complexity</h2>
      <div class="grid grid-cols-2 gap-12 text-2xl">
        <div class="bg-green-900/30 p-6 rounded-lg text-center">
          <div class="text-green-400 font-bold mb-2">Time</div>
          <div class="text-4xl font-mono">O(n)</div>
          <p class="text-sm text-gray-400 mt-2">Single pass</p>
        </div>
        <div class="bg-blue-900/30 p-6 rounded-lg text-center">
          <div class="text-blue-400 font-bold mb-2">Space</div>
          <div class="text-4xl font-mono">O(1)</div>
          <p class="text-sm text-gray-400 mt-2">Just pointers!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slide 16: Final Demo -->
  <section>
    <div class="flex flex-col items-center justify-center h-full">
      <TrappingWater
        client:load
        title="Full Algorithm - Try It!"
        heights={[4, 2, 0, 3, 2, 5]}
        showAlgorithm={true}
        showControls={true}
        showMaxMarkers={true}
      />
    </div>
  </section>

  <!-- Slide 17: Summary -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <h2 class="text-4xl font-bold">Summary</h2>
      <div class="text-xl text-gray-300 space-y-4 max-w-2xl">
        <p class="fragment">
          ✓ Water at each column = min(leftMax, rightMax) - height
        </p>
        <p class="fragment">✓ Two pointers converge from both ends</p>
        <p class="fragment">✓ Process the side with smaller max</p>
        <p class="fragment">✓ The other side guarantees a boundary ≥ our max</p>
      </div>
      <div class="mt-8 text-6xl fragment">🌧️ → 💧</div>
    </div>
  </section>

  <!-- Slide 18: End -->
  <section>
    <div class="flex flex-col items-center justify-center h-full gap-8">
      <h1 class="text-5xl font-bold">Thanks!</h1>
      <p class="text-2xl text-gray-300">LeetCode #42 - Trapping Rain Water</p>
      <p class="text-lg text-gray-400">Two pointers: elegant and efficient</p>
    </div>
  </section>
</RevealLayout>
